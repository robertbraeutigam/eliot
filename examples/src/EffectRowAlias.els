/**
 * A **row alias** names a set of effects once and uses it everywhere: `type Web = {Console, Log}`.
 *
 * A row is a set of abilities and nothing else, so the row — not the computation — is the natural unit to name.
 * The alias is expanded where a row entry names it, so `{Web}` means exactly what `{Console, Log}` means: the same
 * carrier, the same constraints, the same declared row. Nothing downstream knows the name existed.
 *
 * Aliases take parameters (`Fallible[E]`), compose (`Api` names `Web`), and read in every position a row does —
 * a return row, a parameter row, or a suspended slot. They may not name themselves, directly or through another
 * alias.
 *
 * ```sh
 * ./mill examples.run jvm exe-jar examples/src/ -m EffectRowAlias
 * java -jar target/EffectRowAlias.jar
 * ```
 */
type Web = {Console, Log}

/** Rows compose by union, so an alias may name another one. */
type Api[E] = {Web, Throw[E]}

/**
 * Serve one request. The whole capability set of a handler is written once, as `{Api[String]}`, instead of being
 * spelled out — and it is still checked entry by entry: dropping `Log` from `Web` would reject this body.
 */
def serve(path: String): {Api[String]} String = {
   log("serving " ++ path)
   printLine("GET " ++ path)
   fold(path == "/", raise("no such path: " ++ path), "body of " ++ path)
}

/**
 * Run `action` between two log lines. The suspended slot `{} A` is the argument's own row over this definition's
 * ambient carrier, so `audited` stays transparent to whatever the action performs — including the effects the
 * alias names.
 */
def audited[A](action: {} A): {Web} A = {
   log("begin")
   val result = action
   log("end")
   result
}

def main: {Web} Unit = audited({
   printLine(serve("/index") catch (reason -> "failed: " ++ reason))
   printLine(serve("/") catch (reason -> "failed: " ++ reason))
})
