// {Abort} business logic — the same code that runs in production.
def allowed: {Abort} String = "granted"
def denied: {Abort} String = abort

// Discharged into a PURE function: `runAbort` installs the frame `abort` leaves through and answers a plain Option.
// There is no test carrier to declare and no pure interpreter to write — discharging IS running purely.
def testAllowed: Option[String] = runAbort(allowed)
def testDenied: Option[String] = runAbort(denied)

def main: {Console} Unit = {
   printLine(testAllowed.foldOption("DENIED", s -> s))
   printLine(testDenied.foldOption("DENIED", s -> s))
}
