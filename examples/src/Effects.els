/**
 * Direct-style I/O with the `{Console}` effect.
 *
 * `readLine` yields an `Option[String]` and `printLine` consumes a plain `String`, yet both perform `Console`.
 * Writing the one out of the other directly works because effectful calls are sequenced for you — no explicit
 * `flatMap`, `import`, or lift. Everything stays carrier-polymorphic, `main` included — the platform's synthesized
 * entry point binds the runnable carrier; no carrier type ever appears in the program.
 *
 * The `Option` is end of input: `orAbort` reflects the absence into `{Abort}` and `else` discharges it with a
 * fallback, so running out of input is handled where it happens rather than crashing later.
 *
 * ```sh
 * ./mill examples.run jvm exe-jar examples/src/ -m Effects
 * echo "hello effects" | java -jar target/Effects.jar
 * ```
 */
def echo: {Console} Unit = printLine(readLine.orAbort else "(no input)")

def main: {Console} Unit = echo
