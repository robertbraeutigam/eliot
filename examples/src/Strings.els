/**
 * Exercises the `eliot.lang.String` operations on both tracks at once.
 *
 * The route table is decided while *compiling*: `startsWith` runs inside the ability guard, on the compiler
 * track, so each `handler[..]` call site is already bound to one implementation in the emitted bytecode. The
 * report below is built from a line read at *run* time, so the very same functions come out as
 * `java.lang.String` calls there.
 *
 * ```sh
 * ./mill examples.run jvm exe-jar examples/src/ -m Strings
 * echo "  host=localhost  " | java -jar target/Strings.jar
 * ```
 */
import eliot.effect.Abort

ability Route[S: String] {
   def handler: String
}

implement[S: String] Route[S] where startsWith["/api", S] {
   def handler: String = "api"
}

implement[S: String] Route[S] where !startsWith["/api", S] {
   def handler: String = "page"
}

/**
 * The label of a `key=value` setting — everything before the first `=`. Aborts on a line carrying no value.
 */
def labelOf(setting: String): {Abort} String = substring(0, indexOf("=", setting), setting)

/**
 * The label of a setting, falling back to the whole line when it carries no `=`.
 */
def label(setting: String): String = labelOf(setting) else setting

def main: {Console} Unit = {
   val setting = readLine.trim
   printLine(label(setting))
   printLine(setting.toUpperCase)
   printLine(handler["/api/users"] ++ "/" ++ handler["/about"])
}
