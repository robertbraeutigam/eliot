import eliot.compiler.Escape

// The compile-time `Throw[E]`: the sibling of the runtime jvm implementation (jvm/eliot/eliot/effect/Throw.els),
// written over the evaluator's escape intrinsic instead of over a bytecode leaf. It replaces the `Either`-based
// `AbortCarrier` overlay this layer used to carry. `Throw` is re-declared here because name resolution is per-file and
// the implementation below must resolve it; the layer merge verifies the copy agrees with the base.
effect Throw[E] {
   def raise[A](err: E): A
}

/**
 * `raise` is the exit itself: it leaves through the nearest enclosing `escape` frame keyed by this instantiation of
 * `E`, so a raise at one error type passes straight through a `runThrow` installed for another.
 */
implement[E] Throw[E] {
   def raise[A](err: E): A = exit(E[], err)
}

/**
 * Discharge `Throw[E]` on the compile track by installing the frame `raise` leaves through and running the computation
 * inside it. The platform body of the base's body-less signature; the base may not carry it, because the primitive is
 * the platform's.
 */
def runThrow[E, A](obj: {Throw[E]} A): Either[E, A] = escape(E[], obj)
