/**
 * The compiler platform's scoped cell — the compile-track counterpart of a jvm layer's private `withCellInternal` /
 * `readCellInternal` / `writeCellInternal` triple (`docs/effects.md` §9.6), answered by an evaluator intrinsic
 * (`monomorphize/processor/EffectIntrinsics`) rather than by an Eliot body.
 *
 * As with `eliot.compiler.Escape`, **the instantiation is passed as a type value**, the leading argument, because the
 * post-mono evaluator erases type arguments: `withCell(S[], initial, body)`, `read(S[])`, `write(S[], s)`.
 *
 * The cell is scoped to the one `withCell` call: it is gone when that call returns *or is exited through*, so nothing
 * can dangle and nothing survives a frame it sat inside.
 */
def withCell[S, A](key: Type, initial: S, body: Function[Unit, A]): Pair[A, S]

/**
 * The content of the nearest enclosing `withCell` cell whose key equals `key`. No such cell leaves the call stuck.
 */
def read[S](key: Type): S

/**
 * Replace the content of the nearest enclosing `withCell` cell whose key equals `key`.
 */
def write[S](key: Type, s: S): Unit
