// The compile-time `Pair`: the same representation the jvm layer chooses (`jvm/eliot/eliot/lang/Pair.els`), kept in
// the compiler overlay so the compile track is self-sufficient — a layer's compile-time track may not borrow a sibling
// target that might be absent. The cell primitive (`withCell`, effects v6 §9.6) answers this constructor directly.
data Pair[A, B](first: A, second: B)

// Binds the base layer's abstract `pair` to this representation — a `def` name may not be upper-case, so the generated
// `Pair` constructor is not a name the base can declare.
def pair[A, B](first: A, second: B): Pair[A, B] = Pair(first, second)

def foldPair[A, B, C](f: Function[A, Function[B, C]], p: Pair[A, B]): C = p match {
   case Pair(a, b) -> f(a)(b)
}
