import eliot.compiler.Meta

/**
 * The type of integers, each carrying a compiler-tracked range of the values it may hold.
 */
type Int {range: Bound[Interval[BigInteger]]}

implement Numeric[Int] {
   def add(a: Int, b: Int): Int {range(a) + range(b)}
   def subtract(a: Int, b: Int): Int {range(a) - range(b)}
   def multiply(a: Int, b: Int): Int {range(a) * range(b)}
}

implement Show[Int] {
   def show(value: Int): String
}

/**
 * Two integers are equal when they denote the same number. Ranges play no part: an `Int` known to be `0..7` and
 * one known to be `0..255` compare by their values, since a range is meta-information about a type, not part of
 * the value it describes.
 */
implement Eq[Int] {
   def equals(a: Int, b: Int): Bool
}

implement Compare[Int] {
   def lessThanOrEqual(a: Int, b: Int): Bool
}
