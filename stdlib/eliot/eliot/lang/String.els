import eliot.effect.Abort

type String

/**
 * The number of code points in `s`.
 *
 * Counts the text rather than its storage, so the answer is the same on every platform however the string is
 * held — a code point outside the Basic Multilingual Plane counts as one, not as the two units a UTF-16
 * target stores it in. It is not a count of user-perceived characters: a combining sequence counts as its
 * parts. Use it for slicing with `substring`/`take`/`drop`, which index in the same unit, rather than as a
 * measure of visible text width.
 */
def length(s: String): Int

/**
 * `true` when `s` has no characters at all.
 *
 * A string of blanks is *not* empty — `isBlank` is the test that ignores whitespace.
 */
def isEmpty(s: String): Bool

/**
 * `true` when `s` is empty or consists only of whitespace.
 *
 * ```eliot
 * // Read a name, falling back to a placeholder when the user just pressed enter (or ran out of input).
 * def askName: {Console} String = {
 *   val answer = readLine orElse ""
 *   fold(answer.isBlank, "anonymous", answer.trim)
 * }
 * ```
 */
def isBlank(s: String): Bool

/**
 * `true` when `s` begins with `start`.
 *
 * Every string starts with the empty string. The comparison is exact, character by character — there is no
 * case folding.
 */
def startsWith(start: String, s: String): Bool

/**
 * `true` when `s` ends with `end`.
 *
 * Every string ends with the empty string. The comparison is exact, character by character — there is no
 * case folding.
 */
def endsWith(end: String, s: String): Bool

/**
 * `true` when `part` occurs anywhere in `s`.
 *
 * ```eliot
 * // Keep only the log lines that mention the module we are debugging. Spelled as
 * // plain calls rather than `line.contains(..)`, because `.` binds looser than `&&`
 * // — a dot chain beside a boolean operator would have to be parenthesised.
 * def isRelevant(line: String): Bool = contains("eliot.lang", line) && !contains("DEBUG", line)
 * ```
 */
def contains(part: String, s: String): Bool

/**
 * The code points of `s` from `start` (inclusive) to `end` (exclusive).
 *
 * Total: both indices are clamped into `0`..`s.length` and `end` is raised to `start` when it would precede
 * it, so any pair of indices yields a string and none ever fails. That makes slicing safe without a prior
 * length check — an over-long `end` simply runs to the end of `s`, and an inverted range yields `""`.
 *
 * Indices count code points, the same unit `length` returns, so a slice can never cut a character in half
 * whatever the platform stores underneath.
 *
 * ```eliot
 * // The label of a "key=value" setting: everything before the first '='.
 * // Aborts on a line carrying no '=', since `indexOf` finds no position.
 * def labelOf(setting: String): {Abort} String = setting.substring(0, setting.indexOf("="))
 *
 * // Always a String: a line without a value is its own label.
 * def label(setting: String): String = labelOf(setting) else setting
 * ```
 */
def substring(start: Int, end: Int, s: String): String

/**
 * The first `count` code points of `s`, or all of `s` when it is shorter.
 *
 * Total, like `substring`: a negative `count` yields `""`.
 */
def take(count: Int, s: String): String = s.substring(0, count)

/**
 * `s` without its first `count` code points, or `""` when it has no more than that many.
 *
 * Total, like `substring`: a negative `count` yields `s` unchanged.
 */
def drop(count: Int, s: String): String = s.substring(count, s.length)

/**
 * The index of the first occurrence of `part` in `s`, aborting when `part` does not occur.
 *
 * The result counts code points, like every other index, and is a valid `substring` start:
 * `substring(indexOf(part, s), length(s), s)` is the tail of `s` from the match onwards. The absent case is the
 * `Abort` effect rather than a sentinel index, so a caller either discharges it with `else` or propagates it —
 * a missing match can never be mistaken for a position.
 *
 * ```eliot
 * // The extension of a file name — everything after its first dot. Aborts on a
 * // name that has no dot at all.
 * def extensionOf(fileName: String): {Abort} String = fileName.drop(fileName.indexOf(".") + 1)
 *
 * // Always a String: a name without a dot simply has no extension.
 * def extension(fileName: String): String = extensionOf(fileName) else ""
 * ```
 */
def indexOf(part: String, s: String): {Abort} Int = if(s.contains(part), indexOfInternal(part, s))

/**
 * The characters of `s` ahead of the first occurrence of `separator`, or all of `s` when it does not occur.
 *
 * The everyday way to read the left half of a `key=value` line without deciding first whether it has one.
 *
 * ```eliot
 * def label(setting: String): String = setting.before("=")
 * ```
 */
def before(separator: String, s: String): String = s.substring(0, s.indexOf(separator)) else s

/**
 * The characters of `s` past the first occurrence of `separator`, or `""` when it does not occur.
 *
 * `before` and `after` cut at the *first* occurrence, so a later one stays in the tail:
 * `after("=", "a=b=c")` is `"b=c"`.
 */
def after(separator: String, s: String): String = s.drop(s.indexOf(separator) + separator.length) else ""

/**
 * `true` when `s` spells a whole number and nothing else: an optional `-` or `+`, then at least one decimal digit.
 *
 * The exact test `parseInt` guards itself with, so `isInteger(s)` holds precisely when `parseInt(s)` yields a value.
 */
def isInteger(s: String): Bool

/**
 * The whole number `s` spells, aborting when it spells anything else.
 *
 * Reads an optional sign and any number of decimal digits — an `Int` has no width, so a long numeral is read
 * exactly rather than wrapping. Anything else is the `Abort` effect rather than a zero, so a malformed number can
 * never be mistaken for one, and a caller either answers it with `else` or propagates it.
 *
 * ```eliot
 * // A port typed by the user, falling back on anything that is not a number.
 * def port: {Console} Int = parseInt(readLine orElse "") else 8080
 * ```
 */
def parseInt(s: String): {Abort} Int = if(s.isInteger, parseIntInternal(s))

/**
 * `s` without leading and trailing whitespace.
 *
 * Whitespace is decided by the Unicode character properties, so it covers non-breaking and ideographic
 * spaces as well as the ASCII blanks; interior whitespace is untouched.
 */
def trim(s: String): String

/**
 * `s` with every character replaced by its upper-case form.
 *
 * Case conversion is locale-independent: the mapping is the same on every machine and in every run, so a
 * value converted while compiling and one converted while running always agree. That deliberately rules out
 * the locale-sensitive rules of a few languages (Turkish dotless *i*, for one), which belong in a
 * locale-aware text library rather than in the language core.
 */
def toUpperCase(s: String): String

/**
 * `s` with every character replaced by its lower-case form.
 *
 * Locale-independent, exactly as `toUpperCase` — see there for what that rules out.
 *
 * ```eliot
 * // Bring typed input into a canonical form for comparison, so "Quit", "QUIT"
 * // and " quit " all read as the same command.
 * def normalized(input: String): String = input.trim.toLowerCase
 *
 * def isCommand(name: String, input: String): Bool = normalized(input) == name
 * ```
 */
def toLowerCase(s: String): String

/**
 * `s` with every occurrence of `target` replaced by `replacement`.
 *
 * Occurrences are found left to right and each is replaced literally — `target` is plain text, never a
 * pattern — and the scan continues *after* each replacement, so a `replacement` that itself contains
 * `target` is not re-examined. An empty `target` inserts `replacement` between every pair of characters.
 *
 * ```eliot
 * // Fill the single placeholder of a message template.
 * def greeting(name: String): String = "Hello, {}!".replace("{}", name)
 * ```
 */
def replace(target: String, replacement: String, s: String): String

/**
 * `s` written `count` times in a row.
 *
 * Total: a `count` of zero or less yields `""`.
 *
 * ```eliot
 * // Indent a line by two spaces per nesting level.
 * def indent(level: Int, line: String): String = " ".repeat(level * 2) ++ line
 * ```
 */
def repeat(count: Int, s: String): String

/**
 * Two strings are equal when they hold the same characters in the same order.
 */
implement Eq[String] {
   def equals(a: String, b: String): Bool
}

/**
 * Strings are ordered lexicographically by their characters — the order that sorts `"a"` before `"ab"`
 * before `"b"`. It compares character codes rather than alphabets, so every upper-case letter precedes every
 * lower-case one and non-ASCII letters sort by their Unicode value: a stable machine order, not a human
 * collation.
 */
implement Compare[String] {
   def lessThanOrEqual(a: String, b: String): Bool
}

implement Combine[String] {
   def combine(a: String, b: String): String
   def empty: String = ""
}

/**
 * A string's canonical rendering is the string itself — `show` on a `String` is the identity, with no added
 * quoting or escaping.
 */
implement Show[String] {
   def show(value: String): String = value
}

/**
 * The index of the first occurrence of `part` in `s`, or a negative index when there is none — the raw leaf
 * behind `indexOf`, which turns the negative case into an `Abort`. `private` so the sentinel can never
 * escape into user code. Implemented by the backend.
 */
private def indexOfInternal(part: String, s: String): Int

/**
 * The number `s` spells, or `0` when it spells none — the raw leaf behind `parseInt`, which turns that case into an
 * `{Abort}`. `private` so the zero can never escape into user code as if it were a parsed value.
 *
 * Total on purpose: an `if` *builds* both of its arms even though it runs only one, so a leaf that failed on a
 * malformed numeral would fail before `parseInt`'s guard could choose. Implemented by the backend.
 */
private def parseIntInternal(s: String): Int
