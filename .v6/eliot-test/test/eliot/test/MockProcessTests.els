import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.system.Process
import eliot.test.Assertion
import eliot.test.Test
import eliot.test.Mock

/**
 * The process double: what it answers, how an arrangement is matched, and what it records.
 *
 * Nothing here spawns anything: `mocked` binds `Process` to the double by name, and the platform's own
 * implementation is never consulted.
 */
def testCases: {Writer[List[TestResult]]} Unit = {
   "run" should "answer what the matching arrangement says" in mocked {
      whenSpawning("ls-remote", succeeding("v1.0\nv1.1"))

      val result = run(command("git").withArgument("ls-remote"), here)

      result.exitCode shouldBe 0
      result.standardOutput shouldBe "v1.0\nv1.1"
   }
   "run" should "answer a failing arrangement with its code and diagnostics" in mocked {
      whenSpawning("clone", failing(128, "no such repository"))

      val result = run(command("git").withArgument("clone"), here)

      result.exitCode shouldBe 128
      result.standardError shouldBe "no such repository"
   }
   "run" should "answer an exiting arrangement with both its code and its output" in mocked {
      whenSpawning("diff", exiting(1, "one file changed"))

      val result = run(command("git").withArgument("diff"), here)

      result.exitCode shouldBe 1
      result.standardOutput shouldBe "one file changed"
   }
   "run" should "match an arrangement by containment, not by the whole command line" in mocked {
      whenSpawning("--tags", succeeding("matched"))

      run(command("git").withArgument("ls-remote").withArgument("--tags"), here).standardOutput shouldBe "matched"
   }
   "run" should "prefer the most recent arrangement, so a double can be re-armed mid-test" in mocked {
      whenSpawning("ls-remote", succeeding("first"))

      run(command("git").withArgument("ls-remote"), here).standardOutput shouldBe "first"

      whenSpawning("ls-remote", succeeding("second"))

      run(command("git").withArgument("ls-remote"), here).standardOutput shouldBe "second"
   }
   "run" should "succeed silently where the test arranged nothing" in mocked {
      val result = run(command("git").withArgument("status"), here)

      result.exitCode shouldBe 0
      result.standardOutput shouldBe ""
   }
   "run" should "record the command line and the directory it would have run in" in mocked {
      run(command("git").withArgument("fetch"), path("/work"))

      calls shouldBe "/work$ git fetch"
   }
   "whenSpawningCreates" should "make the arranged path exist once the command has run" in mocked {
      whenSpawningCreates("clone", path("/cache/mirror"))

      exists(path("/cache/mirror")).shouldBeFalse

      run(command("git").withArgument("clone"), here)

      exists(path("/cache/mirror")).shouldBeTrue
   }
   "whenSpawningCreates" should "let a test observe that a second run is not needed" in mocked {
      whenSpawningCreates("clone", path("/cache/mirror"))
      whenSpawning("ls-remote", succeeding("v1.0"))

      cloneUnlessPresent
      cloneUnlessPresent

      wasCalledOnce("git clone")
   }
   "runInheritingIo" should "answer the arranged exit code" in mocked {
      whenSpawning("javac", failing(2, "compilation failed"))

      runInheritingIo(command("javac").withArgument("A.java"), here) shouldBe 2
   }
   "runInheritingIo" should "record the same way a captured run does" in mocked {
      runInheritingIo(command("javac"), path("/build"))

      calls shouldBe "/build$ javac"
   }
}

private def here: Path = path(".")

/**
 * Code under test for the observed-not-seeded case: clone only when the mirror is not there — the shape
 * every cache has, and the one a mock that never changes the world cannot check.
 */
private def cloneUnlessPresent: {Process, FileSystem} Unit =
   foldOption(unit, _ -> clone, missingMirror)

private def missingMirror: {FileSystem} Option[Unit] =
   fold(exists(path("/cache/mirror")), None, Some(unit))

private def clone: {Process} Unit = {
   run(command("git").withArgument("clone"), here)

   unit
}
