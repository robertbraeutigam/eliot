import eliot.collection.List
import eliot.test.Assertion
import eliot.test.Test
import eliot.test.Mock
import eliot.test.example.Greeter

/**
 * **One suite, three kinds of test.** Unit tests over pure logic, mocked tests that run effectful code against
 * doubles and assert on what it did, and tests performing real effects inline — registered side by side in one
 * `testCases`, reported by the one runner, counted in the one summary.
 *
 * They mix because `in` supplies only the assertion effect: what a body may do is decided by this suite's declared
 * row (which admits `{Console}`) and by `mocked` where a case wants doubles. **No implementation is named anywhere
 * here, and no fixture is written** — the doubles are the framework's, bound by `mocked`'s own slot.
 */
def testCases: {Writer[List[TestResult]], Console} Unit = {
   // --- 1. a unit test over pure logic ----------------------------------------------------------------------------
   "greeting" should "address the name it was given" in {
      greeting("Bob") shouldBe "Hello, Bob!"
   }
   "greeting" should "not be the bare name" in {
      greeting("Bob") shouldNotBe "Bob"
   }

   // --- 2. mocked: arrange what the console answers, act, then assert on both the effect and the calls -------------
   "greet" should "greet whoever the console offers" in mocked {
      whenReading(singleton("Bob"))

      greet

      calls shouldBe "readLine; printLine Hello, Bob!"
   }
   "greet" should "fall back to a stranger on no input" in mocked {
      greet

      wasCalled("printLine Hello, stranger!")
   }
   "farewell" should "say goodbye, then invite a return" in mocked {
      farewell("Bob")

      wereCalledInOrder(append(singleton("printLine Goodbye, Bob."), "printLine Come back soon!"))
   }
   "farewell" should "print exactly twice, and nothing else" in mocked {
      farewell("Bob")

      wasCalledTimes(2, "printLine")
      onlyTheseWereCalled(singleton("printLine"))
   }

   // --- 3. real effects, written inline ----------------------------------------------------------------------------
   // The suite's row declares `{Console}`, so a body may perform it — bound to the platform's own implementation.
   "real effects" should "be available to a body whose suite declares them" in {
      printLine(" | (this line was printed by a test performing a real Console effect)")
      success
   }
   "expect" should "wrap a body that performs a real effect while it raises" in {
      expect(Failed("after printing"), {
         printLine(" | (printed by a body wrapped in `expect`)")
         fail("after printing")
      })
   }
}
