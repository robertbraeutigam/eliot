data Interval[T](start: Bound[T], end: Bound[T])

def interval[T](start: Bound[T], end: Bound[T]): Interval[T] = Interval(start, end)

def closed[T](start: T, end: T): Interval[T] = Interval(Bounded(start), Bounded(end))

def atLeast[T](start: T): Interval[T] = Interval(Bounded(start), Unbounded)

def atMost[T](end: T): Interval[T] = Interval(Unbounded, Bounded(end))

def whole[T]: Interval[T] = Interval(Unbounded, Unbounded)

def rangeWithin[Lo: BigInteger, Hi: BigInteger](i: Interval[BigInteger]): Bool = i.start match {
   case Unbounded -> false
   case Bounded(s) -> i.end match {
      case Unbounded -> false
      case Bounded(e) -> lessThanOrEqual(Lo, s) && lessThanOrEqual(e, Hi)
   }
}

implement[T ~ Numeric[T] & Compare[T]] Numeric[Interval[T]] {
   def add(a: Interval[T], b: Interval[T]): Interval[T] =
      Interval(add(start(a), start(b)), add(end(a), end(b)))
   def subtract(a: Interval[T], b: Interval[T]): Interval[T] =
      Interval(subtract(start(a), end(b)), subtract(end(a), start(b)))
   def multiply(a: Interval[T], b: Interval[T]): Interval[T] = {
      val c11 = multiply(start(a), start(b))
      val c12 = multiply(start(a), end(b))
      val c21 = multiply(end(a), start(b))
      val c22 = multiply(end(a), end(b))
      Interval(minBound(minBound(minBound(c11, c12), c21), c22), maxBound(maxBound(maxBound(c11, c12), c21), c22))
   }
}
