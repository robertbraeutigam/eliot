import eliot.carrier.Suspend

ability Console[F[_]] {
   def printLine(s: String): {Console} Unit

   def readLine: {Console} Option[String]
}

/**
 * The JVM `Console` instance, generic over any carrier with a `Suspend` base (never pinned to `IO`): each operation reifies
 * a `private` impure leaf native through `suspend`. Because it rides `Suspend`, the same instance serves `IO`, `AbortCarrier[IO]`,
 * etc. — the whole `IO(_ -> ...)` tree stays Eliot-visible to monomorphization; only the leaf natives are opaque.
 */
implement[F[_] ~ Suspend] Console[F] {
   def printLine(s: String): F[Unit] = suspend(_ -> printLineInternal(s))

   def readLine: F[Option[String]] = suspend(_ -> lineOrNone(readLineInternal))
}

/**
 * Build the `Option` a `readLine` yields from what the leaf native returns: `java.io.BufferedReader.readLine` signals
 * end of input with a `null`, which is not a value any Eliot type admits, so it is turned into a `None` here — in
 * ordinary Eliot, at the narrowest possible boundary, following the `eliot.file` rule that a native never constructs an
 * Eliot `data` value in bytecode.
 */
private def lineOrNone(line: String): Option[String] = if(isNull(line), None) else Some(line)

/**
 * The single impure operation behind `printLine`: writes a line to standard output. `private` so user code
 * reaches output only through the `{Console}`-typed `printLine`. Implemented by the backend.
 */
private def printLineInternal(s: String): Unit

/**
 * The single impure operation behind `readLine`: reads a line from standard input, or `null` at end of input (never
 * seen outside this module — `lineOrNone` turns it into a `None` immediately). `private` for the same reason as
 * `printLineInternal`. Implemented by the backend.
 *
 * The stated size is the JVM's own string ceiling: a `java.lang.String` holds at most `2147483647` UTF-16 units, so it
 * holds at most that many code points. This is what a platform-representation transfer looks like — the fact stated is
 * a property of the JVM's `String`, so it lives in this layer rather than in the base, and an MCU target with a smaller
 * line buffer states its own. A line read at end of input is `null`, which has no size at all; the bound describes the
 * strings this can actually yield.
 */
private def readLineInternal: String {closed(0, 2147483647)}

/**
 * `true` when `x` is the null reference — lets `lineOrNone` branch on what the reader returned in ordinary Eliot. The
 * `eliot.file` leaf of the same name and purpose; per-file name resolution means each module declares its own.
 * Implemented by the backend.
 */
private def isNull[A](x: A): Bool
